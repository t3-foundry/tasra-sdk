node_modules/
dist/
*.log
.DS_Store

# Local editor and agent state. These carry absolute paths, host aliases and other
# machine-specific settings — they must never reach a shared history.
.idea/
.claude/

# vitest coverage reports
coverage/

# Private local development state and generated evidence
.tasra/

# The verify harness writes its consolidated report here on every run. Untracked-but-not-ignored
# dirties the tree, and certify's source snapshot is `git status --porcelain` UNSCOPED — it would
# stamp an otherwise clean run `dirty-source=1` / PARTIAL VALIDATION.
/test/verify/out/
